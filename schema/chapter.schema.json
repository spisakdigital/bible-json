{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bible chapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "book", "chapter", "verses"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "book": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "poetry": {
            "const": true
          },
          "paragraphStart": {
            "const": true
          },
          "wordsOfJesus": {
            "const": true
          }
        }
      }
    },
    "headings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beforeVerse", "text"],
        "properties": {
          "beforeVerse": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
