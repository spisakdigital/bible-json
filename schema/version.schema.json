{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset version index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "versions"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "language", "license", "path"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "license": {
            "const": "public-domain"
          },
          "path": {
            "type": "string",
            "pattern": "^data/[a-z0-9]+/$"
          }
        }
      }
    }
  }
}
